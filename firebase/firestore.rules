rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function own(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin authorization records: clients cannot grant themselves admin access.
    match /admins/{uid} {
      allow get: if own(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // User profiles
    match /users/{uid} {
      allow read: if own(uid) || admin();

      allow create: if own(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.provider == request.auth.token.firebase.sign_in_provider
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.phoneNumber is string
        && request.resource.data.emailNotifications is bool;

      allow update: if admin() || (
        own(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.emailNotifications is bool
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'emailNotifications', 'updatedAt', 'lastLogin'])
      );

      allow delete: if admin();
    }

    // Contact messages
    match /contact_messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'status', 'read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'unread'
        && request.resource.data.read == false;

      allow read, update, delete: if admin();
    }

    // Client inquiries
    match /client_inquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'phone', 'service', 'package', 'budget', 'description', 'deadline', 'referenceUrl', 'notes', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'service', 'package', 'budget', 'description', 'deadline', 'referenceUrl', 'notes', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.service is string
        && request.resource.data.service.size() > 0
        && request.resource.data.service.size() <= 80
        && request.resource.data.package is string
        && request.resource.data.package.size() > 0
        && request.resource.data.package.size() <= 80
        && (
          request.resource.data.budget == 'Under ₦50,000'
          || request.resource.data.budget == '₦50,000–₦100,000'
          || request.resource.data.budget == '₦100,000–₦200,000'
          || request.resource.data.budget == '₦200,000–₦300,000'
          || request.resource.data.budget == '₦300,000+'
          || request.resource.data.budget == 'Not sure'
        )
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 3000
        && (
          request.resource.data.deadline == 'ASAP'
          || request.resource.data.deadline == 'Within 1 week'
          || request.resource.data.deadline == '1–2 weeks'
          || request.resource.data.deadline == '2–4 weeks'
          || request.resource.data.deadline == '1–2 months'
          || request.resource.data.deadline == 'Flexible'
        )
        && request.resource.data.referenceUrl is string
        && request.resource.data.referenceUrl.size() <= 1000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if admin();

      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          request.resource.data.status == 'new'
          || request.resource.data.status == 'contacted'
          || request.resource.data.status == 'in-progress'
          || request.resource.data.status == 'completed'
          || request.resource.data.status == 'cancelled'
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if admin();
    }

    // Public portfolio content
    match /projects/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /designs/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /videos/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Social links: public read, active-admin-only writes
    match /social_links/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}